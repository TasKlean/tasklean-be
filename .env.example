# Two-factor secret encryption - Base64 of 32 random bytes (openssl rand -base64 32)
TWO_FACTOR_ENC_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=

# Mail
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=

# Profile (dev | prod)
SPRING_PROFILES_ACTIVE=dev
