# Database
DATABASE_URL=
DB_USERNAME=
DB_PASSWORD=

# JWT
JWT_SECRET=

# CORS
CORS_ALLOWED_ORIGINS=

# Frontend base URL - used to build links in emails (e.g. verify-email)
APP_BASE_URL=

# Two-factor secret encryption - Base64 of 32 random bytes (openssl rand -base64 32)
TWO_FACTOR_ENC_KEY=

# BFF hop secret - Base64 of 32 random bytes (openssl rand -base64 32), shared with the frontend's
# BFF_HOP_SECRET. Comma-separate several values to rotate. Leave empty in dev: nothing is then trusted.
BFF_HOP_SECRETS=

# Google OAuth
GOOGLE_CLIENT_ID=

# Mail - dev needs none of these: docker-compose runs Mailpit and the dev profile points at
# localhost:1025 (inbox UI on http://localhost:8025). Set all four outside dev.
# Keep them commented rather than blank: an empty value overrides the dev default with "",
# it does not fall back to it.
#MAIL_HOST=
#MAIL_PORT=
#MAIL_USERNAME=
#MAIL_PASSWORD=
# Sender on outgoing mail. A sandbox takes any address; a real-delivery provider needs a verified one.
#MAIL_FROM=noreply@tasklean.app
# Both default to true, which is what a hosted sandbox wants. The dev profile already turns them
# off for Mailpit, so only set these to point dev at a remote provider instead.
#MAIL_SMTP_AUTH=true
#MAIL_SMTP_STARTTLS=true

# Profile (dev | prod)
SPRING_PROFILES_ACTIVE=dev
