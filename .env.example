# Database
DATABASE_URL=
DB_USERNAME=
DB_PASSWORD=

# JWT
JWT_SECRET=

# CORS
CORS_ALLOWED_ORIGINS=

# Frontend base URL - used to build links in emails (e.g. verify-email)
